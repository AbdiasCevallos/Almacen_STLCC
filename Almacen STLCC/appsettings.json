{
  "ConnectionStrings": {
    "DefaultConnection": "Server=x.x.x.x;Port=x;Database=example_db;User=user;Password=pass;"
  },
  "LDAP": {
    "Path": "LDAP://x.x.x.x/DC=example,DC=local",
    "Domain": "example.local"
  },
  "MinIO": {
    "Endpoint": "domainexample.dom",
    "AccessKey": "user",
    "SecretKey": "pass",
    "BucketName": "bucket",
    "UseSSL": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
